    <comp lib="6" loc="(710,280)" name="Text"><a name="text" val="R2: s14 и a -&gt; 8"/></comp>
    <comp lib="1" loc="(620,320)" name="AND Gate"><a name="size" val="30"/><a name="inputs" val="2"/></comp>
