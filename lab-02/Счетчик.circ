    <comp lib="6" loc="(420,20)" name="Text"><a name="text" val="Счётчик, вариант 11: 2 14 8 7 6 4 13 10 15 5 0 3 11 12 1 9"/></comp>
    <comp lib="6" loc="(250,60)" name="Text"><a name="text" val="1. ВХОДЫ: a, b - условия ветвления; CLK - такты"/></comp>
    <comp lib="0" loc="(60,100)" name="Clock"><a name="label" val="CLK"/></comp>
    <comp lib="0" loc="(60,160)" name="Pin"><a name="label" val="a"/></comp>
    <comp lib="1" loc="(170,160)" name="NOT Gate"><a name="size" val="20"/></comp>
    <comp lib="0" loc="(300,160)" name="Pin"><a name="label" val="b"/></comp>
    <comp lib="1" loc="(410,160)" name="NOT Gate"><a name="size" val="20"/></comp>
    <comp lib="6" loc="(100,135)" name="Text"><a name="text" val="a"/></comp>
    <comp lib="6" loc="(200,135)" name="Text"><a name="text" val="не a"/></comp>
    <comp lib="6" loc="(340,135)" name="Text"><a name="text" val="b"/></comp>
    <comp lib="6" loc="(440,135)" name="Text"><a name="text" val="не b"/></comp>
    <comp lib="6" loc="(560,190)" name="Text"><a name="text" val="2. R1...R6: «состояние И условие» для развилок"/></comp>
    <comp lib="1" loc="(620,240)" name="AND Gate"><a name="size" val="30"/><a name="inputs" val="2"/></comp>
